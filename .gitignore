# Data stays out of git because of its size. Rohan, 2026-10-18: «Obviously, GitHub is for code, not for
# GB's of data» (data/ held 33 GB that day: the studies, readings, measurements and pictures).
# Every directory named data/, at any depth (data/raw/, archive/data/)
data/
submission/*.csv

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local tool state / caches (pins + equivalents are kept)
**/.detective/verdict_cache.json
**/.detective/reports/
**/.detective/runs/
**/.detective/ledger.jsonl
.lintgate/
.wesker/
.claude/settings.local.json

# OS
.DS_Store

# Secrets / tool state flagged by Prism; coverage artifacts
.env
.env.*
.prism/
coverage.xml
.serena/
# Sonar's scanner working folder (scripts/sonar_local.py reads this scan's task id from it)
.scannerwork/
